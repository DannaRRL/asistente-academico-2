rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['nombre', 'correo', 'zonaHoraria', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'correo', 'zonaHoraria', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.correo is string && request.resource.data.correo.size() <= 254
        && request.resource.data.zonaHoraria is string && request.resource.data.zonaHoraria.size() <= 80
        && request.resource.data.creadoEn is timestamp && request.resource.data.actualizadoEn is timestamp;
    }
    function validClass() {
      return request.resource.data.keys().hasOnly(['materia', 'dia', 'horaInicio', 'horaFin', 'color', 'origen', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['materia', 'dia', 'horaInicio', 'horaFin', 'color', 'origen', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.materia is string && request.resource.data.materia.size() > 0 && request.resource.data.materia.size() <= 100
        && request.resource.data.dia is int && request.resource.data.dia >= 1 && request.resource.data.dia <= 7
        && request.resource.data.horaInicio is string && request.resource.data.horaInicio.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.horaFin is string && request.resource.data.horaFin.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.horaInicio < request.resource.data.horaFin
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.origen in ['ocr', 'manual']
        && request.resource.data.creadoEn is timestamp && request.resource.data.actualizadoEn is timestamp;
    }
    function validExam() {
      return request.resource.data.keys().hasOnly(['materia', 'fechaHora', 'notas', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['materia', 'fechaHora', 'notas', 'creadoEn', 'actualizadoEn'])
        && request.resource.data.materia is string && request.resource.data.materia.size() > 0 && request.resource.data.materia.size() <= 100
        && request.resource.data.fechaHora is timestamp
        && request.resource.data.notas is string && request.resource.data.notas.size() <= 1000
        && request.resource.data.creadoEn is timestamp && request.resource.data.actualizadoEn is timestamp;
    }
    function validSettings() {
      return request.resource.data.keys().hasOnly(['avisarClases', 'avisarExamenDiaAntes', 'avisarExamenDiezMinutos', 'minutosAntesClase', 'minutosAntesExamen', 'actualizadoEn'])
        && request.resource.data.keys().hasAll(['avisarClases', 'avisarExamenDiaAntes', 'avisarExamenDiezMinutos', 'minutosAntesClase', 'minutosAntesExamen', 'actualizadoEn'])
        && request.resource.data.avisarClases is bool
        && request.resource.data.avisarExamenDiaAntes is bool
        && request.resource.data.avisarExamenDiezMinutos is bool
        && request.resource.data.minutosAntesClase == 10
        && request.resource.data.minutosAntesExamen == 10
        && request.resource.data.actualizadoEn is timestamp;
    }
    match /usuarios/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validProfile();
      allow update: if owner(uid) && validProfile() && request.resource.data.creadoEn == resource.data.creadoEn;
      allow delete: if false;

      match /horarios/{claseId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validClass();
        allow update: if owner(uid) && validClass() && request.resource.data.creadoEn == resource.data.creadoEn;
      }
      match /examenes/{examenId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validExam();
        allow update: if owner(uid) && validExam() && request.resource.data.creadoEn == resource.data.creadoEn;
      }
      match /configuracion/{docId} {
        allow read: if owner(uid) && docId == 'notificaciones';
        allow create, update: if owner(uid) && docId == 'notificaciones' && validSettings();
        allow delete: if false;
      }
    }
  }
}
